# =============================================================================
# Mergen Platform — Environment Variables (Example)
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control!
# =============================================================================

# --- CORS / Allowed Origins ------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- WhatsApp / Meta Webhooks ----------------------------------------------
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_PLATFORM_TOKEN=your_platform_token_here
WHATSAPP_WABA_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_meta_verify_token_here

# --- Instagram Webhooks ----------------------------------------------------
INSTAGRAM_VERIFY_TOKEN=your_instagram_verify_token_here

# --- Tenant Management -----------------------------------------------------
ACTIVE_TENANT_ID=
TENANT_MAP=

# --- LLM Gateway -----------------------------------------------------------
# Tier 1 — Local (Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:14b

# Tier 2 — OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_HTTP_REFERER=https://mergen.platform

# Tier 3 — Groq (https://groq.com)
GROQ_API_KEY=gsk_your_groq_key_here

# --- LLM Runtime Settings (optional) ---------------------------------------
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# --- RAG / Embeddings ------------------------------------------------------
MERGEN_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3

# --- Qdrant Vector Store ---------------------------------------------------
QDRANT_COLLECTION=mergen_knowledge
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=