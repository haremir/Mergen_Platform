# ===========================================================================
# Mergen Platform -- Environment Configuration Template
# Copy this file to .env and configure values for your local environment.
# ===========================================================================

# ── 1. LLM Gateway Settings ────────────────────────────────────────────────
# The LLM gateway uses OpenAI-compatible self-host ready APIs.
# Set appropriate model endpoint and API keys.
LLM_PROVIDER_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini

# ── 2. WhatsApp Business Cloud API Settings ────────────────────────────────
# System User Access Token scoped to the WhatsApp Business Account (WABA)
WHATSAPP_PLATFORM_TOKEN=your_whatsapp_platform_token_here
WHATSAPP_WABA_ID=your_whatsapp_waba_id_here

# Meta App Secret for webhook HMAC-SHA256 signature verification
META_APP_SECRET=your_meta_app_secret_here

# ── 3. Panel Backend Settings ──────────────────────────────────────────────
# REST API Port (default: 8000)
PORT=8000
# Comma-separated list of additional origins allowed to connect via CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 4. RAG & Vector Database Settings ──────────────────────────────────────
# RAG default search limits
RAG_TOP_K=3
# Optional: Set model override name for SentenceTransformers
MERGEN_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Database connection: set to "qdrant" or "faiss" (in-memory fallback)
VECTOR_STORE_BACKEND=faiss

# If using Qdrant:
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ── 5. Plan Quota & Rate Limiting Settings ─────────────────────────────────
# Redis URL for production-grade quota enforcement and circuit breakers
REDIS_URL=redis://localhost:6379/0
