# ==============================================================================
# MERGEN PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# Do not commit '.env' files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & DATABASE
# ------------------------------------------------------------------------------
# The SQLAlchemy-compatible connection string (PostgreSQL with asyncpg).
DATABASE_URL=postgresql+asyncpg://mergen:mergen_secret@127.0.0.1:5433/mergen_db

# ------------------------------------------------------------------------------
# 2. LLM CONFIGURATION (OpenRouter, Groq, or Local Ollama)
# ------------------------------------------------------------------------------
# OpenRouter API Credentials (Required for Cloud/Production Routing)
OPENROUTER_API_KEY=sk-or-v1-senin-gercek-keyin-buraya
DEFAULT_LLM_MODEL=qwen/qwen-2.5-32b-instruct

# Local LLM configuration (optional Ollama/Local deployment)
LOCAL_LLM_MODEL=qwen2.5:14b
LOCAL_LLM_URL=http://localhost:11434

# Groq API Credentials (optional fallback)
GROQ_API_KEY=

# LLM Generation Hyperparameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
OPENROUTER_HTTP_REFERER=https://mergen.platform

# ------------------------------------------------------------------------------
# 3. RETRIEVAL AUGMENTED GENERATION (RAG) & VECTOR STORE
# ------------------------------------------------------------------------------
# Local vector store (Faiss fallback) or Qdrant Cloud deployment
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3

# Qdrant configuration (used if Qdrant is target vector store)
QDRANT_COLLECTION=mergen_knowledge
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. WHATSAPP & META DEVELOPER API KEYS
# ------------------------------------------------------------------------------
# Webhook Verification Token (Matches Verify Token set in Meta Developer Portal)
WHATSAPP_VERIFY_TOKEN=mergen_token

# Meta App Secret (Used for verifying X-Hub-Signature-256 header signatures)
META_APP_SECRET=

# WhatsApp Business Account / Graph API client authorization keys
WHATSAPP_PLATFORM_TOKEN=mock_platform_token
WHATSAPP_WABA_ID=mock_waba_id

# ------------------------------------------------------------------------------
# 5. SECURITY & CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of Frontend URLs allowed to call Backend FastAPI server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used to sign JWT tokens — use a strong random string in production
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
# Token expiry in minutes (10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 7. KATIP SCHEDULER
# ------------------------------------------------------------------------------
# Hour (0-23) and minute (0-59) to run daily topic queue processing
KATIP_DAILY_RUN_HOUR=8
KATIP_DAILY_RUN_MINUTE=0